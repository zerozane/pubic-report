BRIGHT_DATA_API_KEY=
BRIGHT_DATA_TIKTOK_SEARCH_DATASET_ID=gd_lu702nij2f790tmv9h
BRIGHT_DATA_TIKTOK_COMMENTS_DATASET_ID=gd_lkf2st302ap89utw5k

# Optional second source for the new dashboard pipeline.
# Confirm the dataset IDs in the new Bright Data account's Scraper Library.
BRIGHT_DATA_X_POSTS_DATASET_ID=

# Social listening input controls.
# Use comma-separated values. Keep these editable so a new topic does not require Bright Data UI changes.
SOCIAL_TOPIC_SLUG=laglace-social-report
# Active collection scope: TikTok records from the current year.
SOCIAL_PERIOD_FROM=2026-01-01
SOCIAL_PERIOD_TO=2026-12-31T23:59:59+07:00
SOCIAL_LANGUAGE=th
SOCIAL_COUNTRY=TH

# Hard safety limits. Bright Data must never receive an unbounded null limit.
BRIGHT_DATA_MAX_INPUTS=20
BRIGHT_DATA_DEFAULT_LIMIT_PER_INPUT=5
BRIGHT_DATA_MAX_LIMIT_PER_INPUT=10
BRIGHT_DATA_MAX_TOTAL_RECORDS=100

# Per-platform collection controls.
# Discovery limit = how many posts/videos to discover per input keyword/hashtag/query.
# Comment/reply limit = how many comments/replies to collect per discovered post/video URL.
SOCIAL_TIKTOK_VIDEO_LIMIT=5
SOCIAL_TIKTOK_COMMENTS_PER_VIDEO=20
SOCIAL_X_POST_LIMIT=30
SOCIAL_X_REPLIES_PER_POST=10

# TikTok discovery inputs. Keywords and hashtags generate tiktok-search.json.
# Direct post URLs generate tiktok-comments.json and must be collected separately.
SOCIAL_TIKTOK_ENABLED=true
SOCIAL_TIKTOK_KEYWORDS=La Glace,laglace,ลากลาซ,ลากลาส,บลัชดำ,ลิปไอติม,คอนซีลเลอร์ลากลาซ
SOCIAL_TIKTOK_HASHTAGS=ลากลาซ,บลัชดำ,ลิปไอติม,ตลับY2K
SOCIAL_TIKTOK_URLS=
BRIGHT_DATA_TIKTOK_SEARCH_INPUT_FIELD=search_keyword
BRIGHT_DATA_TIKTOK_HASHTAG_INPUT_FIELD=search_keyword
BRIGHT_DATA_TIKTOK_URL_INPUT_FIELD=url

# X/Twitter discovery inputs. These generate work/inputs/x-posts.json.
SOCIAL_X_ENABLED=false
SOCIAL_X_QUERIES=("La Glace" OR laglace OR "ลากลาซ" OR "ลากลาส") lang:th,("บลัชดำ" OR "ลิปไอติม" OR "คอนซีลเลอร์ลากลาซ") lang:th
SOCIAL_X_HASHTAGS=ลากลาซ,บลัชดำ,ลิปไอติม
BRIGHT_DATA_X_QUERY_INPUT_FIELD=search_keyword
BRIGHT_DATA_X_HASHTAG_INPUT_FIELD=search_keyword
APIFY_API_TOKEN=
APIFY_X_ACTOR_ID=api-ninja/x-twitter-replies-retweets-scraper
APIFY_X_SEARCH_ACTOR_ID=scrapersdelight/x-tweet-search-scraper
